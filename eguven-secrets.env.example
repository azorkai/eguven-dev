# Sunucuda /root/eguven-secrets.env olarak kaydedilir. Repoya GIRMEZ.
#
# DIKKAT: Buraya PORT yazma. env_file, Dockerfile'daki ENV PORT=8080'i ezer;
# port degisirse Traefik'in loadbalancer.server.port=8080 hedefi tutmaz ve
# site 502 verir. Portu Dockerfile belirlesin.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_TO=your-email@gmail.com

# Cloudflare Turnstile (iletisim formu captcha)
CLOUDFLARE_SITE_KEY=2x00000000000000000000AB
CLOUDFLARE_SECRET_KEY=1x0000000000000000000000000000000AA
